{
	"$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "ASTHG Character's Animation Data",
  "type": "object",
  "properties": {
    "name": {
      "description": "Name of the animation",
      "type": "string"
    },

    "displayName": {
      "description": "How should your animation be displayed?",
      "type": "string"
    },

    "sheets": {
      "description": "Show much spritesheets your animation use?\nSeparated by comma (`,`)",
      "type": "string"
    },

    "prefix": {
      "description": "Reference of the animation on your SparrowAtlas V2 file",
      "type": "string"
    },

    "fps": {
      "description": "Frames per Second that this animation uses",
      "type": "integer",
      "default": 30
    },

    "loop": {
      "description": "Does this animation loops?",
      "type": "boolean",
      "default": false
    },

    "offset": {
      "description": "Should this animation be offset?",
      "type": "array",
      "items": {
        "type": "integer",
        "maximum": 2
      },
      "default": [0, 0]
    },

    "indices": {
      "description": "List of frames that this animation should reproduce",
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  },
  "required": ["name", "prefix"]
}
