{
  "indentation": {
    "character": "tab",
    "tabWidth": 4,
    "trailingWhitespace": true
  },

  "lineEnds": {
    "leftCurly": "none",
    "rightCurly": "both",
    "objectLiteralCurly": {
      "leftCurly": "after"
    }
  },

  "sameLine": {
    "ifBody": "next",
    "ifElse": "next",
    "doWhile": "next",
    "tryBody": "next",
    "tryCatch": "next"
  }
}
